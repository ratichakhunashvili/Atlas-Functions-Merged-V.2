# Copy to .env.local for local development, or set these in the Vercel project.

# --- required ---------------------------------------------------------------

# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# NextAuth will not trust the Host header outside Vercel unless told to, so
# `next start` on localhost rejects every sign-in without this. Vercel sets the
# equivalent itself, so it is only needed for a self-hosted or local run.
AUTH_TRUST_HOST="true"

# Mapbox public token (safe to expose to the browser).
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- storage ----------------------------------------------------------------

# When set, uploads go to Vercel Blob; when absent they go to public/uploads on
# local disk. A deployed site NEEDS this, because its filesystem is read-only.
# Vercel injects it automatically once a Blob store is linked to the project.
# BLOB_READ_WRITE_TOKEN=""

# --- testing shortcuts ------------------------------------------------------

# Force-unlock a hotel, regenerate the itinerary, mark a stop visited, unlock
# achievements, reset progress. Each one only affects the signed-in account.
ENABLE_TEST_TOOLS="true"

# In a PRODUCTION build the flag above is not enough on its own. This second,
# separately named flag must also be set. That is deliberate: it means no single
# stray variable and no copied .env can leave the shortcuts switched on
# somewhere real. Set it only on a demo deployment you intend people to poke at,
# and protect that deployment (Vercel Deployment Protection).
# ALLOW_TEST_TOOLS_IN_PRODUCTION="true"
